# Copier en .env et remplacer chaque valeur. Le .env ne doit jamais aller sur Git.
# Lettres et chiffres uniquement, 24 caractères minimum.
# Générer une valeur sous PowerShell :
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})

# IP du PC serveur sur le Wi-Fi de table (192.168.137.1 avec le point d'accès mobile de Windows)
SERVER_IP=192.168.137.1

POSTGRES_PASSWORD=a_remplacer
DB_APP_PASSWORD=a_remplacer

# Comptes MQTT : "esp01" pour le boîtier, "api" pour l'API
MQTT_ESP_PASSWORD=a_remplacer
MQTT_API_PASSWORD=a_remplacer

# Jetons de l'API : INGEST pour la caméra et le module ML, DASHBOARD pour l'interface
INGEST_TOKEN=a_remplacer
DASHBOARD_TOKEN=a_remplacer

# Jeton du flux vidéo, partagé entre nginx et le conteneur vision
STREAM_TOKEN=a_remplacer

# Démarre aussi le conteneur vision avec "docker compose up -d"
# (mettre un # devant pour lancer la vision sous Windows à la place)
COMPOSE_PROFILES=vision
