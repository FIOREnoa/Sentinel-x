# Copier en vision/.env. Le script le lit au démarrage (plus besoin de $env:...).

# Caméra externe USB
CAMERA=1
CAMERA_BACKEND=dshow
CAP_WIDTH=640
CAP_HEIGHT=480

MODEL_PATH=yolov8n.pt
IMGSZ=640
CONF=0.5

# Zone interdite en coordonnées normalisées (0 à 1), origine en haut à gauche
ZONE=[[0.30,0.15],[0.95,0.15],[0.95,1.0],[0.30,1.0]]
ZONE_NAME=A
MIN_FRAMES=10
CLEAR_FRAMES=15
COOLDOWN=10

# Envoi des alertes à l'API, via Nginx en HTTPS
DEVICE_ID=sentinel-x-cam-01
API_URL=https://localhost/api/v1/alerts
API_TOKEN=valeur_de_INGEST_TOKEN_du_.env_principal
CA_CERT=../certs/ca.crt
SNAPSHOT_IN_ALERT=1

# Stream : le dashboard y accède par https://<IP>/camera/stream?token=...
STREAM_PORT=8000
STREAM_TOKEN=a_remplacer_par_une_longue_chaine_aleatoire
JPEG_QUALITY=70
